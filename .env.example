IP=localhost
PORT=3000
# At least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Mobile app release info for GET /version. Bump APP_LATEST_VERSION after each
# store release; raise APP_MIN_VERSION to force older builds to update.
APP_LATEST_VERSION=1.0.0
APP_MIN_VERSION=1.0.0
ANDROID_STORE_URL=
IOS_STORE_URL=
